slide---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow = 'Da el siguiente paso',
  title,
  text,
  primaryLabel = 'Empezar ahora',
  primaryHref = '#',
  secondaryLabel,
  secondaryHref = '#',
} = Astro.props;

const hasSecondary = !!secondaryLabel;

const BASE = import.meta.env.BASE_URL;
---

<section class="cta-band" style={`background-image: linear-gradient(rgba(29,36,32,0.93), rgba(29,36,32,0.93)), url(${BASE}images/Condo_02_Ok.jpg)`}>
  <div class="container cta-band__inner">
    <span class="eyebrow center">{eyebrow}</span>
    <h2 class="cta-band__title">{title}</h2>
    {text && <p class="cta-band__text">{text}</p>}
    <div class="cta-band__actions">
      <a href={primaryHref} class="btn btn--gold btn--lg">{primaryLabel}</a>
      {hasSecondary && <a href={secondaryHref} class="btn btn--outline-light btn--lg">{secondaryLabel}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: var(--marfil);
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .cta-band__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 760px;
    margin-inline: auto;
  }

  .cta-band .eyebrow {
    color: var(--dorado-suave);
  }

  .cta-band__title {
    color: var(--marfil);
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin-top: 1rem;
  }

  .cta-band__text {
    color: rgba(250, 246, 238, 0.82);
    margin-top: 1rem;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 2rem;
  }
</style>