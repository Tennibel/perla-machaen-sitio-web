---
import { navItems, siteInfo } from '../data/site';

const BASE = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src={`${BASE}images/Logo_Perla_Machaen.png`} alt={`${siteInfo.nombre} logo`} width="170" height="75" loading="lazy" />
      <p class="footer__tagline">El futuro del hogar es saludable.</p>
      <p class="footer__text">
        Empresaria, conferencista y pionera en casas saludables, longevidad y bienestar.
      </p>
      <div class="footer__social">
        <a href={siteInfo.instagram} target="_blank" rel="noopener" aria-label="Instagram">Instagram</a>
        <a href={siteInfo.facebook} target="_blank" rel="noopener" aria-label="Facebook">Facebook</a>
        <a href={siteInfo.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">LinkedIn</a>
        <a href={siteInfo.youtube} target="_blank" rel="noopener" aria-label="YouTube">YouTube</a>
      </div>
    </div>

    <nav class="footer__nav" aria-label="Enlaces del sitio">
      <h3 class="footer__heading">Explora</h3>
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer__col">
      <h3 class="footer__heading">Rutas de conversión</h3>
      <ul>
        <li><a href="/metodo-lisi/">Aplicar al Método LISI</a></li>
        <li><a href="/conferencias/">Solicitar conferencia</a></li>
        <li><a href="/academia-cocreadoers/">Entrar a CocreaDoers</a></li>
        <li><a href="/casas-saludables/">Casas Saludables</a></li>
        <li><a href="/contacto/">Prensa y alianzas</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h3 class="footer__heading">Contacto</h3>
      <ul class="footer__contact">
        <li><a href={`mailto:${siteInfo.email}`}>{siteInfo.email}</a></li>
        <li><a href={siteInfo.whatsapp} target="_blank" rel="noopener">WhatsApp directo</a></li>
      </ul>
      <a href="/contacto/" class="btn btn--gold footer__btn">Contactar al equipo</a>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {year} {siteInfo.nombre}. Todos los derechos reservados.</p>
    <p>Método LISI · Academia CocreaDoers · Real Estate de Longevidad</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--negro-verdoso);
    color: rgba(250, 246, 238, 0.82);
    padding-top: clamp(3rem, 6vw, 5rem);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }

  .footer__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    color: var(--dorado-suave);
    margin-block: 1rem 0.5rem;
  }

  .footer__text {
    font-size: 0.92rem;
    line-height: 1.7;
    max-width: 30ch;
  }

  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.4rem;
  }

  .footer__social a {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dorado-suave);
    transition: color 0.3s ease;
  }
  .footer__social a:hover {
    color: #fff;
  }

  .footer__heading {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--dorado);
    margin-bottom: 1.2rem;
  }

  .footer__nav ul,
  .footer__col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer__nav a,
  .footer__col a {
    font-size: 0.9rem;
    color: rgba(250, 246, 238, 0.82);
    transition: color 0.3s ease;
  }
  .footer__nav a:hover,
  .footer__col a:hover {
    color: var(--dorado-suave);
  }

  .footer__btn {
    margin-top: 1.2rem;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.5rem;
    border-top: 1px solid rgba(250, 246, 238, 0.12);
    font-size: 0.78rem;
    color: rgba(250, 246, 238, 0.55);
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>