fectos tip---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: string;
  imageAlt?: string;
  align?: 'left' | 'center';
}

const {
  eyebrow,
  title,
  subtitle,
  image,
  imageAlt = '',
  align = 'center',
} = Astro.props;

const BASE = import.meta.env.BASE_URL;
const imageSrc = image ? (image.startsWith('/') ? BASE + image.slice(1) : image) : image;
---

<section class:list={['page-hero', { 'page-hero--center': align === 'center' }]}>
  <div class="container page-hero__inner">
    <div class="page-hero__content">
      {eyebrow && <span class="eyebrow center">{eyebrow}</span>}
      <h1 class="page-hero__title">{title}</h1>
      {subtitle && <p class="page-hero__sub">{subtitle}</p>}
      <slot />
    </div>
    {image && (
      <figure class="page-hero__media">
        <img src={imageSrc} alt={imageAlt} width="1200" height="640" loading="eager" />
      </figure>
    )}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2.5rem, 5vw, 4rem);
    background:
      radial-gradient(circle at 80% 0%, rgba(216, 192, 138, 0.2), transparent 50%),
      radial-gradient(circle at 0% 100%, rgba(124, 143, 115, 0.14), transparent 45%),
      var(--marfil);
  }

  .page-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .page-hero__content {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page-hero__title {
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    margin-top: 1rem;
    font-weight: 500;
  }

  .page-hero__sub {
    font-size: clamp(1.02rem, 1.6vw, 1.25rem);
    color: var(--tinta-suave);
    line-height: 1.75;
    margin-top: 1.2rem;
    max-width: 60ch;
  }

  .page-hero__media {
    margin-top: 2.5rem;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-suave);
    max-width: 880px;
    width: 100%;
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 720px) {
    .page-hero {
      text-align: center;
    }
  }
</style>