fluido---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteInfo } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const {
  title = siteInfo.nombre,
  description = siteInfo.descripcion,
  noIndex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const BASE = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {siteInfo.nombre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${BASE}images/ico_Perla_Machaen.png`} type="image/png" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteInfo.nombre} />
    <meta property="og:image" content={new URL(`${BASE}images/Perla_Machaen-Slide_final.png`, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1d2420" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>