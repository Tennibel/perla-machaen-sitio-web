---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';

const perfilLisi = [
  'Realtors y agentes inmobiliarios',
  'Arquitectos e interioristas',
  'Coaches y terapeutas',
  'Médicos y profesionales de la salud',
  'Inversionistas y desarrolladores',
  'Emprendedores wellness',
];

const aprendizajes = [
  { titulo: 'Diagnóstico del espacio', texto: 'Aprende a leer los factores visibles e invisibles que condicionan la salud de un interior.' },
  { titulo: 'Factores invisibles', texto: 'Aire, agua, luz, materiales, electromagnetismo y geobiología aplicados al hogar.' },
  { titulo: 'Hábitos ambientales', texto: 'Criterios de bienestar que transforman la forma en que las personas habitan.' },
  { titulo: 'Consultoría profesional', texto: 'Convierte el diagnóstico en una propuesta de valor y una oferta monetizable.' },
];

const mercado = [
  'Hogares',
  'Oficinas',
  'Desarrollos',
  'Hoteles',
  'Clínicas',
  'Espacios de alto valor',
];

const faqs = [
  {
    q: '¿Qué es el Método LISI?',
    a: 'LISI (Living In Spaces of Inspiration) es la metodología creada por Perla Machaen para diagnosticar y regenerar espacios interiores desde el bienestar, integrando salud ambiental, biohacking espacial y criterios profesionales.',
  },
  {
    q: '¿Para quién está diseñado?',
    a: 'Para realtors, arquitectos, interioristas, coaches, terapeutas, médicos, inversionistas y emprendedores wellness que quieran agregar una capa de valor diferenciadora a su práctica.',
  },
  {
    q: '¿Necesito experiencia previa en bienestar?',
    a: 'No. LISI parte desde los fundamentos y te lleva a construir un criterio profesional claro, combinando diagnóstico, criterios ambientales y consultoría.',
  },
  {
    q: '¿Qué oportunidades de mercado existen?',
    a: 'Hogares, oficinas, desarrollos inmobiliarios, hoteles, clínicas y espacios de alto valor están buscando integrar salud y bienestar a sus espacios.',
  },
  {
    q: '¿Recibo una certificación?',
    a: 'Sí. El programa está orientado a certificarte como consultor en casas saludables, con la metodología y el respaldo de autoridad de Perla Machaen.',
  },
];
---

<Layout
  title="Método LISI"
  description="Certifícate en la nueva profesión de casas saludables con el Método LISI de Perla Machaen."
>
  <PageHero
    eyebrow="Método LISI"
    title="Certifícate en la nueva profesión de casas saludables."
    subtitle="Living In Spaces of Inspiration: la metodología para diagnosticar, regenerar y convertir espacios saludables en una consultoría profesional y monetizable."
  >
    <div class="hero-actions">
      <a href="/contacto/" class="btn btn--gold btn--lg">Aplicar a LISI</a>
      <a href="#faq" class="btn btn--outline btn--lg">Resolver dudas</a>
    </div>
  </PageHero>

  <!-- QUÉ ES -->
  <section class="section bloque">
    <div class="container bloque__grid">
      <div>
        <span class="eyebrow">Qué es LISI</span>
        <h2 class="titulo">Un método profesional, no otro curso más.</h2>
      </div>
      <div class="bloque__texto">
        <p>
          LISI nace de la evolución de Perla Machaen: de liderar el Real Estate de lujo en Miami a crear
          una metodología que une salud ambiental, biohacking espacial, diseño consciente y valor inmobiliario.
        </p>
        <p>
          Es la ruta para aprender a evaluar el espacio — aire, agua, luz, materiales, humedad, ruido,
          hábitos y bienestar interior — y convertirlo en una nueva profesión con demanda creciente.
        </p>
      </div>
    </div>
  </section>

  <!-- PARA QUIÉN -->
  <section class="section para-quien">
    <div class="container">
      <span class="eyebrow center">Para quién es</span>
      <h2 class="titulo center">Una profesión que suma valor a tu expertise.</h2>
      <div class="para-quien__grid">
        {perfilLisi.map((perfil) => <span class="perfil-card">{perfil}</span>)}
      </div>
    </div>
  </section>

  <!-- QUÉ APRENDERÁS -->
  <section class="section aprender">
    <div class="container">
      <span class="eyebrow center">Qué aprenderás</span>
      <h2 class="titulo center">Cuatro pilares para convertirte en consultor.</h2>
      <div class="aprender__grid">
        {
          aprendizajes.map((item, i) => (
            <article class="aprender__card">
              <span class="aprender__num">0{i + 1}</span>
              <h3>{item.titulo}</h3>
              <p>{item.texto}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- OPORTUNIDAD DE MERCADO -->
  <section class="section mercado">
    <div class="container mercado__grid">
      <div>
        <span class="eyebrow">Oportunidad de mercado</span>
        <h2 class="titulo">Espacios que ya buscan integrar salud y bienestar.</h2>
        <p class="lead">
          La demanda por entornos saludables crece en múltiples industrias. LISI te prepara para responder
          a una oportunidad que atraviesa al real estate, la arquitectura, la hotelería y la salud.
        </p>
      </div>
      <div class="mercado__tags">
        {mercado.map((m) => <span class="mercado__tag">{m}</span>)}
      </div>
    </div>
  </section>

  <!-- AUTORIDAD -->
  <section class="section autoridad">
    <div class="container autoridad__grid">
      <div class="autoridad__media">
        <img src="/images/stock/interior-moderno.jpg" alt="Perla Machaen, autoridad en real estate y bienestar" width="534" height="534" loading="lazy" />
      </div>
      <div>
        <span class="eyebrow">Autoridad de Perla</span>
        <h2 class="titulo">Respaldado por una trayectoria real.</h2>
        <ul class="autoridad__lista">
          <li>#1 en Real Estate de lujo en Miami por más de una década</li>
          <li>Fundadora de The Wellness Habitat Company desde 2018</li>
          <li>Publicada en Forbes, Caras, Reforma y Real Estate Market</li>
          <li>Conferencista y creadora de la categoría Real Estate de Longevidad</li>
        </ul>
        <a href="/sobre-perla/" class="btn btn--dark">Conocer su historia</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq" id="faq">
    <div class="container faq__inner">
      <span class="eyebrow center">Preguntas frecuentes</span>
      <h2 class="titulo center">Resuelve tus dudas antes de aplicar.</h2>
      <div class="faq__list">
        {
          faqs.map((f) => (
            <details class="faq__item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Aplicación"
    title="Da el primer paso hacia tu nueva profesión."
    text="Aplica al Método LISI y descubre cómo convertir las casas saludables en una carrera con propósito y valor."
    primaryLabel="Aplicar ahora"
    primaryHref="/contacto/"
    secondaryLabel="Hablar con el equipo"
    secondaryHref="/contacto/"
  />
</Layout>

<style>
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .bloque__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 2.5rem;
    align-items: start;
  }
  .bloque__texto p {
    color: var(--tinta-suave);
    font-size: 1.05rem;
    line-height: 1.85;
    margin-bottom: 1rem;
  }

  .para-quien {
    background: var(--arena);
  }
  .para-quien__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .perfil-card {
    background: var(--blanco-calido);
    border-radius: var(--radius);
    padding: 1.4rem;
    text-align: center;
    font-weight: 400;
    font-size: 0.98rem;
    box-shadow: var(--shadow-card);
    border: 1px solid rgba(29, 36, 32, 0.05);
  }

  .aprender__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .aprender__card {
    background: var(--blanco-calido);
    border-radius: var(--radius);
    padding: 1.7rem;
    border-top: 3px solid var(--dorado);
    box-shadow: var(--shadow-card);
  }
  .aprender__num {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--dorado);
  }
  .aprender__card h3 {
    font-size: 1.35rem;
    margin-block: 0.6rem;
  }
  .aprender__card p {
    color: var(--tinta-suave);
    font-size: 0.93rem;
  }

  .mercado__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .mercado__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .mercado__tag {
    background: var(--negro-verdoso);
    color: var(--marfil);
    padding: 0.7rem 1.3rem;
    border-radius: var(--radius-pill);
    font-size: 0.9rem;
  }

  .autoridad {
    background: var(--blanco-calido);
  }
  .autoridad__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 3rem;
    align-items: center;
  }
  .autoridad__media img {
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
  }
  .autoridad__lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin: 1.6rem 0 1.8rem;
  }
  .autoridad__lista li {
    padding-left: 1.5rem;
    position: relative;
    color: var(--negro-verdoso-suave);
  }
  .autoridad__lista li::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: var(--dorado);
  }

  .faq__inner {
    max-width: 820px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
  }
  .faq__list {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .faq__item {
    background: var(--blanco-calido);
    border: 1px solid rgba(29, 36, 32, 0.08);
    border-radius: var(--radius);
    padding: 0.2rem 1.4rem;
    box-shadow: var(--shadow-suave);
  }
  .faq__item summary {
    cursor: pointer;
    font-weight: 500;
    padding: 1.1rem 0;
    font-size: 1.05rem;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq__item summary::after {
    content: '+';
    font-weight: 400;
    font-size: 1.4rem;
    color: var(--dorado);
  }
  .faq__item[open] summary::after {
    content: '−';
  }
  .faq__item p {
    color: var(--tinta-suave);
    padding-bottom: 1.2rem;
    line-height: 1.75;
  }

  @media (max-width: 900px) {
    .bloque__grid,
    .mercado__grid,
    .autoridad__grid {
      grid-template-columns: 1fr;
    }
    .aprender__grid {
      grid-template-columns: 1fr 1fr;
    }
    .para-quien__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .aprender__grid,
    .para-quien__grid {
      grid-template-columns: 1fr;
    }
  }
</style>